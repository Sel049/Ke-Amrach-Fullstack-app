# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ke_geberew
DB_PORT=3306

# Database Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Chapa Payment Gateway
CHAPA_SECRET_KEY=CHASECK_TEST-your-key-here
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your-key-here
CHAPA_WEBHOOK_SECRET=your-secret-here
CHAPA_API_BASE=https://api.chapa.co/v1
CHAPA_SANDBOX_BASE=https://sandbox.chapa.co/v1

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# Cloudinary (persistent image hosting - REQUIRED for production image persistence)
# Free tier: 25GB media storage + 25GB bandwidth/month, no egress fees, CDN + auto-optimization.
# Without these, images are stored on the server's local disk (ephemeral on Render - they vanish on redeploy).
# Create a free account: https://cloudinary.com/dashboard -> Dashboard -> API Keys.
# Use EITHER CLOUDINARY_URL, OR set all three variables below.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security (for sessions or JWT if used elsewhere)
JWT_SECRET=dev_jwt_secret
SESSION_SECRET=dev_session_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Optional: Firebase Admin (leave unset in development)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=your_service_account_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
